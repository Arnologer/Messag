<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/chatListFragment">

    <fragment
        android:id="@+id/chatListFragment"
        android:name="com.securemessenger.ui.fragment.ChatListFragment"
        android:label="Chats"
        tools:layout="@layout/fragment_chat_list">
        
        <action
            android:id="@+id/action_chatListFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
            
        <action
            android:id="@+id/action_chatListFragment_to_createGroupFragment"
            app:destination="@id/createGroupFragment" />
    </fragment>

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.securemessenger.ui.fragment.ChatFragment"
        android:label="Chat"
        tools:layout="@layout/fragment_chat">
        
        <argument
            android:name="chatId"
            app:argType="string" />
            
        <argument
            android:name="chatName"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/createGroupFragment"
        android:name="com.securemessenger.ui.fragment.CreateGroupFragment"
        android:label="Create Group"
        tools:layout="@layout/fragment_create_group" />

</navigation>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    tools:context=".ui.adapter.ChatAdapter">

    <ImageView
        android:id="@+id/imageViewAvatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="Chat Avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/textViewChatName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/textViewUnreadCount"
        app:layout_constraintStart_toEndOf="@id/imageViewAvatar"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="John Doe" />

    <TextView
        android:id="@+id/textViewLastMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="@android:color/darker_gray"
        app:layout_constraintEnd_toEndOf="@id/textViewChatName"
        app:layout_constraintStart_toStartOf="@id/textViewChatName"
        app:layout_constraintTop_toBottomOf="@id/textViewChatName"
        tools:text="Last message preview..." />

    <TextView
        android:id="@+id/textViewUnreadCount"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_unread_count"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="5"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
